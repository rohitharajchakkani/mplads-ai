# Backend Environment Configuration Template
# Copy to backend/.env for local development. Never commit real secrets.

APP_ENV=development
DATABASE_URL=sqlite:///./data/processed/mplads_ai.sqlite
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=209715200

# Optional: Gemini API Key for Ask AI grounding explanation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
